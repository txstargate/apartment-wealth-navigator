---
import Base from '../../layouts/Base.astro'
import { BENCHMARK_SOURCE_NATIONAL } from '../../lib/benchmark'
---

<Base
	title="NOI Quick Check | Apartment Wealth Navigator"
	description="A fast, transparent read on whether your apartment building is leaving NOI, and building value, on the table."
	canonical="https://apartmentwealthnavigator.com/tools/noi-check"
>
	<section class="noi-check">
		<h1>NOI Quick Check</h1>
		<p>
			Enter what you already know about the building. Every assumption below is visible and you
			can change it before you see a result.
		</p>

		<form id="noi-form" class="noi-form">
			<label for="units">Number of units</label>
			<input id="units" type="number" min="1" step="1" required />

			<fieldset class="noi-form__group">
				<legend>Current gross rent</legend>
				<input id="grossRent" type="number" min="0" step="1" required />
				<div class="noi-form__radios">
					<label><input type="radio" name="rentPeriod" value="annual" checked /> Annual</label>
					<label><input type="radio" name="rentPeriod" value="monthly" /> Monthly</label>
				</div>
			</fieldset>

			<fieldset class="noi-form__group">
				<legend>Current annual operating expenses</legend>
				<label class="noi-form__checkbox">
					<input id="notSureOpex" type="checkbox" checked />
					Not sure, estimate from an expense ratio instead
				</label>
				<div id="opexAmountField" hidden>
					<label for="annualOpex">Annual operating expenses</label>
					<input id="annualOpex" type="number" min="0" step="1" />
				</div>
				<div id="opexRatioField">
					<label for="opexRatio">
						Operating expense ratio: <span id="opexRatioValue">45%</span>
					</label>
					<input id="opexRatio" type="range" min="0.35" max="0.55" step="0.01" value="0.45" />
					<p class="noi-form__hint">
						DMV 5-to-50-unit apartments typically run 35% to 55% of effective gross income
						(excluding debt service), higher for older buildings with owner-paid utilities.
					</p>
				</div>
			</fieldset>

			<fieldset class="noi-form__group">
				<legend>Market rent per unit (optional)</legend>
				<label class="noi-form__checkbox">
					<input id="knowMarketRent" type="checkbox" />
					I know my market rent per unit and want to enter it myself
				</label>
				<div id="marketRentField" hidden>
					<label for="marketRentPerUnit">Your estimate of market rent per unit (monthly)</label>
					<input id="marketRentPerUnit" type="number" min="0" step="1" />
					<p class="noi-form__hint">This is your own input, not a figure the tool supplied.</p>
				</div>
				<p id="benchmarkNote" class="noi-form__hint">
					<span id="benchmarkSourceLine">Source: {BENCHMARK_SOURCE_NATIONAL}</span>. Leave this
					unchecked and the tool runs a Health-check on your expense ratio instead of guessing
					your market rent; the full benchmark for your ZIP comes in the follow-up.
				</p>
				<p id="benchmarkAttribution" class="noi-form__hint" hidden></p>
			</fieldset>

			<label for="capRate">
				Representative cap rate: <span id="capRateValue">6.0%</span>
				<span class="noi-form__note">Market estimate. Moves with rates.</span>
			</label>
			<input id="capRate" type="range" min="0.05" max="0.075" step="0.0025" value="0.06" />

			<label for="location">Building location (ZIP or city)</label>
			<input id="location" type="text" placeholder="e.g. Washington, DC or 20009" required />

			<button type="submit">Calculate</button>
		</form>

		<div id="result-panel" class="result-panel" hidden>
			<h2>Your result</h2>

			<div id="full-result" hidden>
				<dl class="result-grid">
					<dt>Current NOI</dt>
					<dd id="current-noi"></dd>

					<dt>Potential NOI</dt>
					<dd id="potential-noi"></dd>

					<dt>Annual NOI gap</dt>
					<dd id="noi-gap"></dd>

					<dt>Estimated value impact</dt>
					<dd id="value-impact"></dd>
				</dl>
			</div>

			<div id="health-check-result" hidden>
				<dl class="result-grid">
					<dt>Current NOI</dt>
					<dd id="hc-current-noi"></dd>

					<dt>Operating expense ratio</dt>
					<dd id="hc-opex-ratio"></dd>

					<dt>Where that lands</dt>
					<dd id="hc-flag"></dd>
				</dl>
				<p id="hc-sensitivity"></p>
				<p id="hcBenchmarkNote" class="noi-form__hint">
					<span id="hcBenchmarkSourceLine">Source: {BENCHMARK_SOURCE_NATIONAL}</span>. Your
					building's market-rent benchmark and full NOI gap arrive in the follow-up once you
					request it below.
				</p>
				<p id="hcBenchmarkAttribution" class="noi-form__hint" hidden></p>
			</div>

			<p class="disclaimer">
				This is an educational estimate, not an appraisal and not a broker opinion of value.
			</p>
			<p class="disclaimer">No PII stored on the site beyond the GoHighLevel submission.</p>

			<form id="lead-form" class="lead-form">
				<h3>Get the real numbers on your building</h3>
				<label for="leadName">Name</label>
				<input id="leadName" type="text" required />

				<label for="leadEmail">Email</label>
				<input id="leadEmail" type="email" required />

				<label for="leadPhone">Phone</label>
				<input id="leadPhone" type="tel" required />

				<button type="submit">Send me the real numbers</button>
				<p class="consent">
					By submitting, you agree to be contacted by phone, text, or email about your inquiry.
					Message and data rates may apply. Reply STOP to opt out.
				</p>
			</form>

			<div id="lead-local-panel" class="result-panel" hidden>
				<h3>Book a time with Shafiq</h3>
				<p>Your building is in the DC, Virginia, or Maryland service area.</p>
				<a class="cta" href="/get-started">Continue to booking</a>
			</div>

			<div id="lead-advisory-panel" class="result-panel" hidden>
				<h3>Get matched with a local advisor</h3>
				<p>Shafiq covers DC, Virginia, and Maryland. We will route your building from here.</p>
				<a class="cta" href="/get-started">Continue</a>
			</div>
		</div>
	</section>
</Base>

<script>
	import { computeNoi, healthCheck, valueSensitivity } from '../../lib/noi'
	import { buildLeadPayload, submitLead } from '../../lib/ghl'
	import { benchmarkSource } from '../../lib/benchmark'

	const form = document.getElementById('noi-form') as HTMLFormElement
	const unitsInput = document.getElementById('units') as HTMLInputElement
	const grossRentInput = document.getElementById('grossRent') as HTMLInputElement
	const locationInput = document.getElementById('location') as HTMLInputElement

	const notSureOpex = document.getElementById('notSureOpex') as HTMLInputElement
	const opexAmountField = document.getElementById('opexAmountField') as HTMLElement
	const opexRatioField = document.getElementById('opexRatioField') as HTMLElement
	const annualOpexInput = document.getElementById('annualOpex') as HTMLInputElement
	const opexRatioInput = document.getElementById('opexRatio') as HTMLInputElement
	const opexRatioValue = document.getElementById('opexRatioValue') as HTMLElement

	const knowMarketRent = document.getElementById('knowMarketRent') as HTMLInputElement
	const marketRentField = document.getElementById('marketRentField') as HTMLElement
	const marketRentInput = document.getElementById('marketRentPerUnit') as HTMLInputElement

	const capRateInput = document.getElementById('capRate') as HTMLInputElement
	const capRateValue = document.getElementById('capRateValue') as HTMLElement

	const resultPanel = document.getElementById('result-panel') as HTMLElement
	const fullResult = document.getElementById('full-result') as HTMLElement
	const healthCheckResult = document.getElementById('health-check-result') as HTMLElement

	const currentNoiEl = document.getElementById('current-noi') as HTMLElement
	const potentialNoiEl = document.getElementById('potential-noi') as HTMLElement
	const noiGapEl = document.getElementById('noi-gap') as HTMLElement
	const valueImpactEl = document.getElementById('value-impact') as HTMLElement

	const hcCurrentNoiEl = document.getElementById('hc-current-noi') as HTMLElement
	const hcOpexRatioEl = document.getElementById('hc-opex-ratio') as HTMLElement
	const hcFlagEl = document.getElementById('hc-flag') as HTMLElement
	const hcSensitivityEl = document.getElementById('hc-sensitivity') as HTMLElement

	const benchmarkSourceLineEl = document.getElementById('benchmarkSourceLine') as HTMLElement
	const benchmarkAttributionEl = document.getElementById('benchmarkAttribution') as HTMLElement
	const hcBenchmarkSourceLineEl = document.getElementById('hcBenchmarkSourceLine') as HTMLElement
	const hcBenchmarkAttributionEl = document.getElementById('hcBenchmarkAttribution') as HTMLElement

	const leadForm = document.getElementById('lead-form') as HTMLFormElement
	const leadLocalPanel = document.getElementById('lead-local-panel') as HTMLElement
	const leadAdvisoryPanel = document.getElementById('lead-advisory-panel') as HTMLElement

	function formatCurrency(value: number): string {
		return value.toLocaleString('en-US', {
			style: 'currency',
			currency: 'USD',
			maximumFractionDigits: 0,
		})
	}

	notSureOpex.addEventListener('change', () => {
		const notSure = notSureOpex.checked
		opexAmountField.hidden = notSure
		opexRatioField.hidden = !notSure
		annualOpexInput.required = !notSure
	})

	opexRatioInput.addEventListener('input', () => {
		opexRatioValue.textContent = `${Math.round(Number(opexRatioInput.value) * 100)}%`
	})

	capRateInput.addEventListener('input', () => {
		capRateValue.textContent = `${(Number(capRateInput.value) * 100).toFixed(1)}%`
	})

	knowMarketRent.addEventListener('change', () => {
		marketRentField.hidden = !knowMarketRent.checked
		marketRentInput.required = knowMarketRent.checked
	})

	function updateBenchmarkSource(): void {
		const { label, attribution } = benchmarkSource(locationInput.value)

		benchmarkSourceLineEl.textContent = label
		hcBenchmarkSourceLineEl.textContent = label

		benchmarkAttributionEl.textContent = attribution ?? ''
		benchmarkAttributionEl.hidden = !attribution
		hcBenchmarkAttributionEl.textContent = attribution ?? ''
		hcBenchmarkAttributionEl.hidden = !attribution
	}

	locationInput.addEventListener('input', updateBenchmarkSource)

	form.addEventListener('submit', (event) => {
		event.preventDefault()
		updateBenchmarkSource()

		const units = Number(unitsInput.value)
		const rentPeriod = (form.querySelector('input[name="rentPeriod"]:checked') as HTMLInputElement).value
		const grossRentAmount = Number(grossRentInput.value)
		const grossAnnualRent = rentPeriod === 'monthly' ? grossRentAmount * 12 : grossRentAmount
		const capRate = Number(capRateInput.value)

		const annualOpex = notSureOpex.checked
			? grossAnnualRent * Number(opexRatioInput.value)
			: Number(annualOpexInput.value)
		const opexRatio = annualOpex / grossAnnualRent

		if (knowMarketRent.checked && marketRentInput.value) {
			const result = computeNoi({
				units,
				grossAnnualRent,
				annualOpex,
				marketRentPerUnit: Number(marketRentInput.value),
				capRate,
			})

			currentNoiEl.textContent = formatCurrency(result.currentNoi)
			potentialNoiEl.textContent = formatCurrency(result.potentialNoi)
			noiGapEl.textContent = formatCurrency(result.noiGap)
			valueImpactEl.textContent = formatCurrency(result.valueImpact)

			fullResult.hidden = false
			healthCheckResult.hidden = true
		} else {
			const currentNoi = grossAnnualRent - annualOpex
			const flag = healthCheck(opexRatio, { low: 0.35, high: 0.55 })
			const sensitivity = valueSensitivity(capRate)

			hcCurrentNoiEl.textContent = formatCurrency(currentNoi)
			hcOpexRatioEl.textContent = `${Math.round(opexRatio * 100)}%`
			hcFlagEl.textContent = flag === 'high' ? 'High' : flag === 'lean' ? 'Lean' : 'Normal'
			hcSensitivityEl.textContent = `Each $1,000 of annual NOI is roughly ${formatCurrency(sensitivity)} of value at a ${(capRate * 100).toFixed(1)}% cap rate.`

			fullResult.hidden = true
			healthCheckResult.hidden = false
		}

		resultPanel.hidden = false
	})

	leadForm.addEventListener('submit', async (event) => {
		event.preventDefault()

		const name = (document.getElementById('leadName') as HTMLInputElement).value
		const email = (document.getElementById('leadEmail') as HTMLInputElement).value
		const phone = (document.getElementById('leadPhone') as HTMLInputElement).value

		const payload = buildLeadPayload({
			name,
			email,
			phone,
			location: locationInput.value,
			toolName: 'NOI Leak Audit',
			sourcePage: window.location.pathname,
			units: Number(unitsInput.value),
		})

		await submitLead(payload)

		leadLocalPanel.hidden = payload.route !== 'local'
		leadAdvisoryPanel.hidden = payload.route !== 'advisory'
	})
</script>

<style>
	.noi-check {
		max-width: 640px;
		margin: 0 auto;
		padding: var(--space-6) var(--space-4);
	}

	.noi-form {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin-top: var(--space-5);
	}

	.noi-form label {
		font-weight: 600;
	}

	.noi-form__note {
		display: block;
		font-weight: 400;
		font-size: var(--text-sm);
		color: var(--color-slate);
	}

	.noi-form__hint {
		font-weight: 400;
		font-size: var(--text-sm);
		color: var(--color-slate);
		margin: var(--space-1) 0 0;
	}

	.noi-form input[type='number'],
	.noi-form input[type='text'] {
		font-size: var(--text-base);
		padding: var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: 2px;
		margin-bottom: var(--space-3);
	}

	.noi-form input[type='range'] {
		width: 100%;
		margin-bottom: var(--space-2);
	}

	.noi-form__group {
		border: 1px solid var(--color-border);
		border-radius: 2px;
		padding: var(--space-3);
		margin-bottom: var(--space-3);
	}

	.noi-form__radios {
		display: flex;
		gap: var(--space-4);
		font-weight: 400;
		margin-top: var(--space-2);
	}

	.noi-form__checkbox {
		display: block;
		font-weight: 400;
		margin-bottom: var(--space-2);
	}

	.noi-form button {
		align-self: flex-start;
		background: var(--color-navy);
		color: var(--color-bg);
		border: none;
		font-size: var(--text-base);
		font-weight: 600;
		padding: var(--space-2) var(--space-4);
		border-radius: 2px;
		cursor: pointer;
	}

	.noi-form button:hover {
		background: var(--color-accent);
		color: var(--color-obsidian);
	}

	.result-panel {
		margin-top: var(--space-6);
		padding-top: var(--space-5);
		border-top: 1px solid var(--color-border);
	}

	.result-grid {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: var(--space-2) var(--space-4);
		margin-bottom: var(--space-4);
	}

	.result-grid dt {
		color: var(--color-slate);
	}

	.result-grid dd {
		margin: 0;
		font-weight: 600;
		text-align: right;
	}

	.disclaimer {
		font-size: var(--text-sm);
		color: var(--color-slate);
	}

	.consent {
		font-size: var(--text-sm);
		color: var(--color-slate);
		margin-top: var(--space-1);
	}

	.lead-form {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin-top: var(--space-5);
	}

	.lead-form input {
		font-size: var(--text-base);
		padding: var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: 2px;
		margin-bottom: var(--space-2);
	}

	.lead-form button {
		align-self: flex-start;
		background: var(--color-navy);
		color: var(--color-bg);
		border: none;
		font-size: var(--text-base);
		font-weight: 600;
		padding: var(--space-2) var(--space-4);
		border-radius: 2px;
		cursor: pointer;
	}

	.lead-form button:hover {
		background: var(--color-accent);
		color: var(--color-obsidian);
	}

	.cta {
		display: inline-block;
		margin-top: var(--space-3);
		background: var(--color-navy);
		color: var(--color-bg);
		text-decoration: none;
		font-weight: 600;
		padding: var(--space-2) var(--space-4);
		border-radius: 2px;
	}

	.cta:hover {
		background: var(--color-accent);
		color: var(--color-obsidian);
	}
</style>
