---
import Base from '../../layouts/Base.astro'
---

<Base
	title="Tools | Apartment Wealth Navigator"
	description="Free tools for apartment owners: a fast, transparent read on NOI and building value."
	canonical="https://apartmentwealthnavigator.com/tools/"
>
	<section class="tools">
		<h1>Tools</h1>
		<ul class="tools__list">
			<li>
				<a href="/tools/noi-check">NOI Quick Check</a>
				<p>
					See your current NOI, an estimated NOI gap, and the value that gap represents, in a
					few minutes.
				</p>
			</li>
		</ul>
	</section>
</Base>

<style>
	.tools {
		max-width: 640px;
		margin: 0 auto;
		padding: var(--space-6) var(--space-4);
	}

	.tools__list {
		list-style: none;
		margin: var(--space-5) 0 0;
		padding: 0;
	}

	.tools__list li {
		border-top: 1px solid var(--color-border);
		padding: var(--space-3) 0;
	}

	.tools__list a {
		font-weight: 600;
		color: var(--color-text);
		text-decoration: none;
	}

	.tools__list a:hover {
		color: var(--color-accent);
	}
</style>
