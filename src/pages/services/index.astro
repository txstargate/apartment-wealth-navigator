---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'

const services = await getCollection('services')
const order = ['noi', 'refinance', 'sale']
const sorted = [...services].sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id))
---

<Base
	title="Services | Apartment Wealth Navigator"
	description="Three ways Shafiq Hirani works with apartment owners: NOI optimization, refinance positioning, and sale readiness."
	canonical="https://apartmentwealthnavigator.com/services/"
>
	<section class="services">
		<h1>Three ways I work with owners</h1>
		<ul class="services__list">
			{
				sorted.map((service) => (
					<li>
						<a href={`/services/${service.id}`}>{service.data.title}</a>
						<p>{service.data.description}</p>
					</li>
				))
			}
		</ul>
	</section>
</Base>

<style>
	.services {
		max-width: 720px;
		margin: 0 auto;
		padding: var(--space-6) var(--space-4);
	}

	.services__list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.services__list li {
		border-top: 1px solid var(--color-border);
		padding: var(--space-4) 0;
	}

	.services__list a {
		font-family: var(--font-headline);
		font-size: var(--text-xl);
		color: var(--color-obsidian);
		text-decoration: none;
	}

	.services__list a:hover {
		color: var(--color-accent);
	}
</style>
