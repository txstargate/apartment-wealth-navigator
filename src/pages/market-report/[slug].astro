---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import JsonLd from '../../components/JsonLd.astro'
import { buildArticleSchema } from '../../lib/schema'
import { orderReports, monthLabel } from '../../lib/reports'

// One page per monthly DMV market report (src/content/reports/<yyyy-mm>-<market>.mdx).
export async function getStaticPaths() {
	const reports = orderReports(await getCollection('reports'))
	return reports.map((entry) => ({ params: { slug: entry.id }, props: { entry, others: reports.filter((r) => r.id !== entry.id) } }))
}

const { entry, others } = Astro.props
const { Content } = await render(entry)
const canonical = `https://apartmentwealthnavigator.com/market-report/${entry.id}/`
const dataAsOf = new Date(entry.data.dataAsOf).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
const schema = buildArticleSchema({
	title: entry.data.title,
	description: entry.data.description,
	url: canonical,
	author: 'Shafiq Hirani',
	datePublished: new Date(entry.data.publishDate).toISOString(),
})
---

<Base title={`${entry.data.title} | Apartment Wealth Navigator`} description={entry.data.description} canonical={canonical}>
	<JsonLd data={schema} />
	<article class="report">
		<p class="report__kicker">DMV Market Report · {entry.data.market} · {monthLabel(entry.data.month)}</p>
		<h1>{entry.data.title}</h1>
		<p class="report__meta">For owners of 4 to 20 unit buildings. Data as of {dataAsOf}. Sources are named in the report.</p>

		<div class="report__body">
			<Content />
		</div>

		<aside class="report__next">
			<p class="report__next-kicker">Your building's number</p>
			<a href="/value-navigator/">Get a conservative, base, and optimistic value for your building</a>
		</aside>

		{
			others.length > 0 && (
				<nav class="report__archive" aria-label="Earlier reports">
					<h2>Earlier reports</h2>
					<ul>
						{others.map((r) => (
							<li><a href={`/market-report/${r.id}/`}>{r.data.title}</a></li>
						))}
					</ul>
				</nav>
			)
		}
		<p class="report__all"><a href="/market-report/">All DMV market reports</a></p>
	</article>
</Base>

<style>
	.report {
		max-width: 720px;
		margin: 0 auto;
		padding: var(--space-6) var(--space-4);
	}

	.report__kicker {
		font-size: var(--text-sm);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-accent-deep);
		margin: 0 0 var(--space-2);
	}

	.report__meta {
		color: var(--color-slate);
		margin: 0 0 var(--space-5);
	}

	/* Metric tables scroll inside the column on phones. */
	.report__body :global(table) {
		display: block;
		max-width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
		margin: var(--space-3) 0;
	}

	.report__body :global(th),
	.report__body :global(td) {
		padding: var(--space-1) var(--space-2);
		text-align: left;
		border-bottom: 1px solid var(--color-border);
		vertical-align: top;
	}

	.report__next {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		border-left: 3px solid var(--color-accent);
		padding-left: var(--space-3);
		margin: var(--space-5) 0;
	}

	.report__next-kicker {
		font-size: var(--text-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-slate);
		margin: 0;
	}

	.report__next a {
		font-family: var(--font-headline);
		font-size: var(--text-lg);
		color: var(--color-navy);
		text-decoration: none;
	}

	.report__next a:hover {
		color: var(--color-accent-deep);
	}

	.report__archive h2 {
		font-size: var(--text-lg);
		margin: 0 0 var(--space-2);
	}

	.report__all a,
	.report__archive a {
		color: var(--color-navy);
	}
</style>
