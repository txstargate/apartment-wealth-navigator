---
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../../layouts/Base.astro'
import GeoCTA from '../../components/GeoCTA.astro'
import { filterPublished } from '../../lib/content'
import { BENCHMARK_SOURCE_DMV, COSTAR_ATTRIBUTION_NOTE } from '../../lib/benchmark'

export async function getStaticPaths() {
  const locations = filterPublished(await getCollection('locations'))

  return locations.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const canonical = `https://apartmentwealthnavigator.com/locations/${entry.id}`
const dataAsOf = entry.data.dataAsOf
	? new Date(entry.data.dataAsOf).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
	: null
---

<Base title={`${entry.data.name} | Apartment Wealth Navigator`} description={entry.data.summary} canonical={canonical}>
	{
		entry.data.headerImage && (
			<div class="location__header">
				<Image
					class="location__header-image"
					src={entry.data.headerImage}
					alt={entry.data.headerAlt ?? `Small apartment buildings in ${entry.data.name}`}
					widths={[640, 1024, 1600, 1920]}
					sizes="100vw"
					loading="eager"
					fetchpriority="high"
				/>
				{
					entry.data.headerVideo && (
						<video
							class="location__header-video"
							data-src={entry.data.headerVideo}
							muted
							loop
							playsinline
							autoplay
							preload="none"
							aria-hidden="true"
							tabindex="-1"
						/>
					)
				}
			</div>
		)
	}
	<article class="location">
		<p class="location__jurisdiction">{entry.data.jurisdiction}</p>
		<h1>{entry.data.name}</h1>

		<p class="location__data-as-of">
			{dataAsOf ? `Data as of ${dataAsOf}.` : 'Data as of: pending the next remax-intel refresh.'}{' '}
			Source: {BENCHMARK_SOURCE_DMV}.
		</p>
		<p class="location__attribution">{COSTAR_ATTRIBUTION_NOTE}.</p>

		<div class="location__body">
			<Content />
		</div>

		<GeoCTA />
	</article>
</Base>

<style>
	/* Full-width header band above the article column; the image is cropped
	   to a wide banner and never pushes the page wider than the viewport. */
	.location__header {
		position: relative;
		width: 100%;
		max-height: 46vh;
		overflow: hidden;
		background: var(--color-navy);
	}

	.location__header-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 45%;
		opacity: 0;
		transition: opacity 600ms ease;
	}

	.location__header-video.is-playing {
		opacity: 1;
	}

	@media (max-width: 640px), (prefers-reduced-motion: reduce) {
		.location__header-video {
			display: none;
		}
	}

	.location__header-image {
		display: block;
		width: 100%;
		height: 46vh;
		max-height: 520px;
		object-fit: cover;
		object-position: center 45%;
	}

	.location {
		max-width: 720px;
		margin: 0 auto;
		padding: var(--space-6) var(--space-4);
	}

	.location__jurisdiction {
		font-family: var(--font-body);
		font-size: var(--text-sm);
		letter-spacing: 0.1em;
		color: var(--color-accent);
		text-transform: uppercase;
		margin-bottom: var(--space-2);
	}

	.location__data-as-of {
		color: var(--color-slate);
		font-size: var(--text-sm);
		margin-bottom: var(--space-1);
	}

	.location__attribution {
		color: var(--color-slate);
		font-size: var(--text-sm);
		margin-bottom: var(--space-4);
	}

	.location__body {
		margin-bottom: var(--space-5);
	}
</style>

<script>
	import { attachLoopVideos } from '../../lib/loop-video'
	attachLoopVideos()
</script>
