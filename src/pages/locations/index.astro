---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import GeoCTA from '../../components/GeoCTA.astro'
import { filterPublished } from '../../lib/content'
import { BENCHMARK_SOURCE_DMV, COSTAR_ATTRIBUTION_NOTE } from '../../lib/benchmark'

const locations = filterPublished(await getCollection('locations'))
---

<Base
	title="DMV Locations | Apartment Wealth Navigator"
	description="Market reads for apartment owners in Washington DC, Northern Virginia, and Maryland."
	canonical="https://apartmentwealthnavigator.com/locations/"
>
	<section class="locations">
		<h1>DMV locations</h1>
		<p>Local market reads for owners in Washington DC, Northern Virginia, and Maryland.</p>
		<p class="locations__source">
			Source: {BENCHMARK_SOURCE_DMV}. {COSTAR_ATTRIBUTION_NOTE}.
		</p>

		{
			locations.length === 0 ? (
				<p>Location pages are in progress. Check back soon, or get a read on your building now.</p>
			) : (
				<ul class="locations__list">
					{locations.map((entry) => (
						<li>
							<a href={`/locations/${entry.id}`}>{entry.data.name}</a>
							<p>{entry.data.summary}</p>
							<p class="locations__data-as-of">
								{entry.data.dataAsOf
									? `Data as of ${new Date(entry.data.dataAsOf).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}.`
									: 'Data as of: pending the next remax-intel refresh.'}{' '}
								Source: {BENCHMARK_SOURCE_DMV}.
							</p>
						</li>
					))}
				</ul>
			)
		}

		<GeoCTA />
	</section>
</Base>

<style>
	.locations {
		max-width: 720px;
		margin: 0 auto;
		padding: var(--space-6) var(--space-4);
	}

	.locations__list {
		list-style: none;
		margin: var(--space-5) 0;
		padding: 0;
	}

	.locations__list li {
		border-top: 1px solid var(--color-border);
		padding: var(--space-3) 0;
	}

	.locations__list a {
		font-weight: 600;
		color: var(--color-text);
		text-decoration: none;
	}

	.locations__list a:hover {
		color: var(--color-accent);
	}

	.locations__source,
	.locations__data-as-of {
		color: var(--color-slate);
		font-size: var(--text-sm);
	}
</style>
