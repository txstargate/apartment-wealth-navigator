---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../../layouts/Base.astro'
import GeoCTA from '../../components/GeoCTA.astro'
import { filterPublished } from '../../lib/content'
import { BENCHMARK_SOURCE_DMV, COSTAR_ATTRIBUTION_NOTE } from '../../lib/benchmark'

// Every area shows as a tile with its header photograph. Published pages
// link; draft pages (waiting on the remax-intel data) show the tile with a
// "market read in progress" line and no link, so the hub never 404s.
const all = await getCollection('locations')
const publishedIds = new Set(filterPublished(all).map((entry) => entry.id))
const order = ['washington-dc', 'arlington-va', 'alexandria-va', 'montgomery-county-md', 'prince-georges-county-md']
const locations = [...all].sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id))
---

<Base
	title="DMV Locations | Apartment Wealth Navigator"
	description="Market reads for apartment owners in Washington DC, Northern Virginia, and Maryland."
	canonical="https://apartmentwealthnavigator.com/locations/"
>
	<section class="locations">
		<h1>DMV locations</h1>
		<p>Local market reads for owners in Washington DC, Northern Virginia, and Maryland.</p>
		<p class="locations__source">
			Source: {BENCHMARK_SOURCE_DMV}. {COSTAR_ATTRIBUTION_NOTE}.
		</p>

		<ul class="locations__grid">
			{
				locations.map((entry) => {
					const published = publishedIds.has(entry.id)
					const Tag = published ? 'a' : 'div'
					return (
						<li>
							<Tag class="location-tile" href={published ? `/locations/${entry.id}` : undefined}>
								{entry.data.headerImage && (
									<Image
										class="location-tile__image"
										src={entry.data.headerImage}
										alt={entry.data.headerAlt ?? entry.data.name}
										widths={[480, 800, 1200]}
										sizes="(max-width: 640px) 100vw, 50vw"
										loading="lazy"
									/>
								)}
								<span class="location-tile__text">
									<span class="location-tile__jurisdiction">{entry.data.jurisdiction}</span>
									<span class="location-tile__name">{entry.data.name}</span>
									<span class="location-tile__status">
										{published
											? entry.data.dataAsOf
												? `Data as of ${new Date(entry.data.dataAsOf).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}.`
												: 'Market read available.'
											: 'Market read in progress.'}
									</span>
								</span>
							</Tag>
						</li>
					)
				})
			}
		</ul>

		<GeoCTA />
	</section>
</Base>

<style>
	.locations {
		max-width: 960px;
		margin: 0 auto;
		padding: var(--space-6) var(--space-4);
	}

	.locations__grid {
		list-style: none;
		margin: var(--space-5) 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: var(--space-4);
	}

	.location-tile {
		display: block;
		color: inherit;
		text-decoration: none;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		overflow: hidden;
		background: var(--color-bg);
	}

	.location-tile__image {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
	}

	.location-tile__text {
		display: block;
		padding: var(--space-3);
	}

	.location-tile__jurisdiction {
		display: block;
		font-size: var(--text-sm);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.location-tile__name {
		display: block;
		font-family: var(--font-headline);
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--color-navy);
		margin: var(--space-1) 0;
	}

	.location-tile__status {
		display: block;
		font-size: var(--text-sm);
		color: var(--color-slate);
	}

	a.location-tile:hover .location-tile__name {
		color: var(--color-accent-deep);
	}

	.locations__source,
	.locations__data-as-of {
		color: var(--color-slate);
		font-size: var(--text-sm);
	}
</style>
