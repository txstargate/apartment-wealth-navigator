---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../../layouts/Base.astro'
import GeoCTA from '../../components/GeoCTA.astro'
import { filterPublished, orderInsights } from '../../lib/content'
import { BENCHMARK_SOURCE_DMV, COSTAR_ATTRIBUTION_NOTE } from '../../lib/benchmark'

// DMV hub, rebuilt 2026-09-21 after Greg's review: no stub tiles and no
// unfinished-market promises. Three jurisdiction blocks. DC links the published
// DC-branch articles (real data); Virginia and Maryland state the licence,
// the areas covered, and the guides that apply everywhere. A location page
// appears here only once it is published.
const locations = await getCollection('locations')
const byId = new Map(locations.map((l) => [l.id, l]))
const publishedIds = new Set(filterPublished(locations).map((l) => l.id))
const dc = orderInsights(filterPublished(await getCollection('dc')))
const universal = orderInsights(filterPublished(await getCollection('universal'))).filter((e) => e.data.dcCounterpart)

const blocks = [
	{
		id: 'dc',
		name: 'Washington, DC',
		licence: 'DC broker licence BR98379340',
		areas: ['Capitol Hill', 'Dupont Circle', 'Logan Circle', 'Georgetown', 'Shaw', 'U Street', 'Columbia Heights', 'Petworth', 'Brightwood', 'Anacostia', 'Trinidad'],
		tiles: ['washington-dc'],
		note: 'The DC branch of every guide, with cap rates, price per unit, and TOPA timing from reported sales.',
	},
	{
		id: 'va',
		name: 'Northern Virginia',
		licence: 'Virginia broker licence 0225230181',
		areas: ['Arlington', 'Alexandria', 'Falls Church', 'Fairfax County'],
		tiles: ['arlington-va', 'alexandria-va'],
		note: 'Same review, same underwriting. The guides below apply as written; a Virginia branch follows as the sales data is compiled.',
	},
	{
		id: 'md',
		name: 'Maryland',
		licence: 'Maryland broker licence 663088',
		areas: ['Montgomery County', "Prince George's County", 'Silver Spring', 'Takoma Park', 'Hyattsville'],
		tiles: ['montgomery-county-md', 'prince-georges-county-md'],
		note: 'Same review, same underwriting. The guides below apply as written; a Maryland branch follows as the sales data is compiled.',
	},
]
---

<Base
	title="DMV Coverage | Apartment Wealth Navigator"
	description="Where Shafiq Hirani works: Washington DC, Northern Virginia, and Maryland, licensed as a broker in all three, with the DC market read published first."
	canonical="https://apartmentwealthnavigator.com/locations/"
>
	<section class="dmv-intro">
		<p class="dmv-intro__kicker">DMV</p>
		<h1>Three jurisdictions, one review</h1>
		<p class="dmv-intro__lede">
			I hold a broker licence in Washington DC, Virginia, and Maryland, and the building review runs the
			same way in each. What changes is the data underneath it: cap rates, price per unit, tax
			treatment, and in DC the tenant purchase rights that set a sale's timeline.
		</p>
		<p class="dmv-intro__report">
			Each month I publish a Washington DC market read for owners of 4 to 20 unit buildings.
			<a href="/market-report/">Read the DMV Market Report</a>.
		</p>
		<p class="dmv-intro__source">Source: {BENCHMARK_SOURCE_DMV}. {COSTAR_ATTRIBUTION_NOTE}.</p>
	</section>

	{
		blocks.map((b) => (
			<section class="dmv-block" id={b.id}>
				<div class="dmv-block__media">
					{b.tiles.map((id) => {
						const entry = byId.get(id)
						if (!entry?.data.headerImage) return null
						const published = publishedIds.has(id)
						const Tag = published ? 'a' : 'div'
						return (
							<Tag class="dmv-tile" href={published ? `/locations/${id}` : undefined}>
								<Image
									src={entry.data.headerImage}
									alt={entry.data.headerAlt ?? entry.data.name}
									widths={[480, 800, 1200]}
									sizes="(max-width: 900px) 100vw, 40vw"
									loading="lazy"
								/>
								<span class="dmv-tile__name">{entry.data.name}</span>
								{published && <span class="dmv-tile__cue">View market data →</span>}
							</Tag>
						)
					})}
				</div>
				<div class="dmv-block__body">
					<h2>{b.name}</h2>
					<p class="dmv-block__licence">{b.licence}</p>
					<p class="dmv-block__areas">{b.areas.join(' · ')}</p>
					<p>{b.note}</p>
					{b.tiles
						.filter((id) => publishedIds.has(id))
						.map((id) => (
							<p class="dmv-block__cta">
								<a class="dmv-block__button" href={`/locations/${id}`}>
									See the {byId.get(id)?.data.name.replace(', DC', ' DC')} market data
								</a>
							</p>
						))}
					<ul class="dmv-block__links">
						{(b.id === 'dc' ? dc : universal).map((a) => (
							<li>
								<a href={`/insights/${a.id}/`}>{a.data.title}</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		))
	}

	<section class="dmv-close">
		<h2>Outside these three?</h2>
		<p>
			Tell me where the building is on the next screen. Inside DC, Virginia, or Maryland you book
			directly. Anywhere else, I connect you with an advisor in your market and say so up front.
		</p>
		<GeoCTA />
	</section>
</Base>

<style>
	.dmv-intro {
		max-width: 760px;
		margin: 0 auto;
		padding: var(--space-7) var(--space-4) var(--space-5);
	}

	.dmv-intro__kicker {
		font-size: var(--text-sm);
		letter-spacing: 0.12em;
		color: var(--color-accent-deep);
		margin: 0 0 var(--space-2);
	}

	.dmv-intro h1 {
		font-size: var(--text-3xl);
		margin: 0 0 var(--space-3);
	}

	.dmv-intro__lede {
		font-size: var(--text-lg);
		color: var(--color-slate);
		margin: 0 0 var(--space-3);
	}

	.dmv-intro__report {
		margin: 0 0 var(--space-3);
	}

	.dmv-intro__report a {
		color: var(--color-navy);
		font-weight: 600;
	}

	.dmv-intro__source {
		font-size: var(--text-sm);
		color: var(--color-slate);
		margin: 0;
	}

	.dmv-block {
		max-width: 1100px;
		margin: 0 auto var(--space-6);
		padding: 0 var(--space-4);
		display: grid;
		grid-template-columns: 2fr 3fr;
		gap: var(--space-5);
		align-items: start;
	}

	.dmv-block__media {
		display: grid;
		gap: var(--space-3);
	}

	.dmv-tile {
		position: relative;
		display: block;
		border-radius: 4px;
		overflow: hidden;
		color: inherit;
		text-decoration: none;
	}

	.dmv-tile :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	a.dmv-tile :global(img) {
		transition: transform 300ms ease, filter 300ms ease;
	}

	a.dmv-tile:hover :global(img),
	a.dmv-tile:focus-visible :global(img) {
		transform: scale(1.03);
		filter: brightness(0.9);
	}

	.dmv-tile__cue {
		position: absolute;
		right: var(--space-3);
		bottom: var(--space-2);
		background: var(--color-navy);
		color: #fff;
		font-size: var(--text-sm);
		font-weight: 600;
		padding: var(--space-1) var(--space-2);
		border-radius: 2px;
	}

	a.dmv-tile:hover .dmv-tile__cue {
		background: var(--color-accent);
		color: var(--color-obsidian);
	}

	.dmv-block__cta {
		margin: var(--space-3) 0;
	}

	.dmv-block__button {
		display: inline-block;
		background: var(--color-navy);
		color: var(--color-bg);
		text-decoration: none;
		font-weight: 600;
		padding: var(--space-2) var(--space-4);
		border-radius: 2px;
	}

	.dmv-block__button:hover {
		background: var(--color-accent);
		color: var(--color-obsidian);
	}

	@media (prefers-reduced-motion: reduce) {
		a.dmv-tile :global(img) {
			transition: none;
		}
	}

	.dmv-tile__name {
		position: absolute;
		left: var(--space-3);
		bottom: var(--space-2);
		color: #fff;
		font-weight: 600;
		text-shadow: 0 1px 8px rgba(10, 13, 20, 0.7);
	}

	.dmv-block h2 {
		font-size: var(--text-xl);
		margin: 0 0 var(--space-1);
	}

	.dmv-block__licence {
		font-size: var(--text-sm);
		color: var(--color-accent-deep);
		letter-spacing: 0.04em;
		margin: 0 0 var(--space-2);
	}

	.dmv-block__areas {
		color: var(--color-slate);
		margin: 0 0 var(--space-3);
	}

	.dmv-block__links {
		margin: var(--space-3) 0 0;
		padding-left: 1.1rem;
	}

	.dmv-block__links li {
		margin-bottom: var(--space-1);
	}

	.dmv-block__links a {
		color: var(--color-navy);
	}

	.dmv-close {
		max-width: 760px;
		margin: var(--space-7) auto 0;
		padding: var(--space-6) var(--space-4) var(--space-7);
		background: var(--color-cream);
		border-radius: 4px;
	}

	.dmv-close h2 {
		font-size: var(--text-xl);
		margin: 0 0 var(--space-2);
	}

	@media (max-width: 900px) {
		.dmv-block {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.dmv-close {
			margin-left: var(--space-4);
			margin-right: var(--space-4);
		}
	}
</style>
