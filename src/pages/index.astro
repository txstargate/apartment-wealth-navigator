---
import { Image, getImage } from 'astro:assets'
import Base from '../layouts/Base.astro'
import JsonLd from '../components/JsonLd.astro'
import siteSchema from '../data/person-professionalservice.json'
import GeoCTA from '../components/GeoCTA.astro'
// Homepage hero photograph (design pass, 2026-09-17): picked from Friday's
// image-ideation run, see projects/apartmentwealthnavigator memory
// project_awn_site_imagery. Caption stays generic: it is a DC-style street,
// not a named block.
import heroImage from '../assets/hero-dc-rowhouses.jpg'
import noiHeader from '../assets/services/noi.jpg'
import saleHeader from '../assets/services/sale.jpg'
import refinanceHeader from '../assets/services/refinance.jpg'
import portraitNavy from '../assets/shafiq/portrait-navy.jpg'

// Hero playlist order: the rowhouse loop first, then each DMV area in
// turn. Files live in public/video (1080p) and public/video/mobile (720p).
const heroPlaylist = [
	{ src: '/video/awn-hero-loop.mp4', mobile: '/video/mobile/awn-hero-loop.mp4' },
	{ src: '/video/locations/washington-dc.mp4', mobile: '/video/mobile/washington-dc.mp4' },
	{ src: '/video/locations/arlington-va.mp4', mobile: '/video/mobile/arlington-va.mp4' },
	{ src: '/video/locations/alexandria-va.mp4', mobile: '/video/mobile/alexandria-va.mp4' },
	{ src: '/video/locations/montgomery-county-md.mp4', mobile: '/video/mobile/montgomery-county-md.mp4' },
	{ src: '/video/locations/prince-georges-county-md.mp4', mobile: '/video/mobile/prince-georges-county-md.mp4' },
]

const ogHero = await getImage({ src: heroImage, width: 1200, format: 'jpg' })

const serviceTiles = [
	{
		href: '/services/noi',
		title: 'NOI Optimization and Expense Review',
		blurb: 'Read the income and expense lines a lender or a buyer will price, then work them in an order that holds up.',
		image: noiHeader,
		alt: 'Shafiq Hirani reviewing a rent roll on a tablet at a brick apartment building',
	},
	{
		href: '/services/sale',
		title: 'Sale Readiness and Disposition Advisory',
		blurb: "Get the building, the numbers, and the document file ready before a buyer's underwriter reads them.",
		image: saleHeader,
		alt: 'A well-kept brick apartment building at golden hour',
	},
	{
		href: '/services/refinance',
		title: 'Refinance Positioning',
		blurb: 'Work the numbers your next lender will size the loan on, while those numbers can still change.',
		image: refinanceHeader,
		alt: 'Shafiq Hirani at a table with a laptop, walking through the numbers',
	},
]

const stats = [
	{ value: '225+', label: 'Owners helped improve NOI' },
	{ value: '75+', label: 'Apartment buildings sold' },
	{ value: '155+', label: 'Refinances positioned' },
	{ value: '35+', label: 'Years in real estate' },
]
---

<Base
	title="Apartment Wealth Navigator | Shafiq Hirani, Apartment NOI and Sale Advisory"
	description="DC, Virginia, and Maryland apartment building owners: find the NOI leak, decide whether to refinance or sell, and get a read on your building."
	canonical="https://apartmentwealthnavigator.com/"
	ogImage={ogHero.src}
>
	<JsonLd data={siteSchema} />
	<section class="hero">
		<Image
			class="hero__image"
			src={heroImage}
			alt="A quiet street of red brick rowhouses converted to small apartment buildings in morning light"
			widths={[640, 1024, 1600, 1920]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<!-- Silent loops, played as a playlist that crossfades through every
		     area: the rowhouse hero first, then DC, Arlington, Alexandria,
		     Montgomery County, Prince George's, and round again. Two stacked
		     <video> layers; src/lib/loop-video.ts drives them. Phones get the
		     lighter 720p files; reduced-motion visitors keep the still. -->
		<div
			class="hero__stage"
			data-playlist={JSON.stringify(heroPlaylist)}
			aria-hidden="true"
		>
			<video class="hero__video" muted playsinline preload="none" tabindex="-1"></video>
			<video class="hero__video" muted playsinline preload="none" tabindex="-1"></video>
		</div>
		<div class="hero__overlay" aria-hidden="true"></div>
		<div class="hero__content">
			<h1>Raise your building's NOI before a lender or a buyer sets its value for you</h1>
			<p>
				I am Shafiq Hirani. I advise small and mid-sized apartment owners in Washington DC,
				Virginia, and Maryland. The work is raising net operating income (NOI), cutting wasted
				expenses, and positioning a building for a stronger refinance or sale.
			</p>
			<GeoCTA />
		</div>
	</section>

	<section class="stats">
		<h2 class="visually-hidden">Track record</h2>
		<ul class="stats__grid">
			{
				stats.map((stat) => (
					<li class="stats__card">
						<p class="stats__value">{stat.value}</p>
						<p class="stats__label">{stat.label}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="content-block">
		<h2>The market stopped covering the difference</h2>
		<p>Rising values used to hide weak operating performance. Higher interest rates ended that.</p>
		<p>
			Your next lender and your next buyer both price the building on the net operating income it
			produces today, from documents they can verify.
		</p>
		<p>
			A broker who tells you to wait for the market to come back is asking you to sit out a
			repricing that already happened.
		</p>
	</section>

	<section class="content-block">
		<h2>You are in one of these four situations</h2>
		<p>You own one apartment building or several, in your own name or through an LLC.</p>
		<ul>
			<li>Your loan matures inside the next two years.</li>
			<li>Insurance, taxes, water, and payroll have climbed faster than your rents.</li>
			<li>You are weighing a sale and want to know what the building would sell for on today's numbers.</li>
			<li>The building already runs well and you want the next layer of upside.</li>
		</ul>
	</section>

	<section class="content-block">
		<h2>Three ways I work with owners</h2>
		<div class="services-grid">
			{
				serviceTiles.map((tile) => (
					<a class="service-tile" href={tile.href}>
						<Image
							class="service-tile__image"
							src={tile.image}
							alt={tile.alt}
							widths={[480, 800, 1200]}
							sizes="(max-width: 640px) 100vw, 33vw"
							loading="lazy"
						/>
						<h3>{tile.title}</h3>
						<p>{tile.blurb}</p>
					</a>
				))
			}
		</div>
	</section>

	<section class="content-block">
		<h2>Read before you decide</h2>
		<p>
			The <a href="/insights">Insights Hub</a> covers net operating income, refinance timing, sale
			readiness, and the DC-specific version of each question.
		</p>
	</section>

	<section class="content-block content-block--band">
		<div class="who">
			<Image
				class="who__portrait"
				src={portraitNavy}
				alt="Shafiq Hirani, portrait"
				widths={[240, 480]}
				sizes="160px"
				loading="lazy"
			/>
			<div>
				<h2>Who reads your numbers</h2>
				<p>
					Commercial Real Estate Advisor and Broker with RE/MAX Distinctive Commercial, licensed in
					Washington DC, Virginia, and Maryland. CCIM, MBA, and Professional Engineer.
				</p>
				<p><a href="/about">More about how I work</a></p>
			</div>
		</div>
	</section>

	<section class="content-block content-block--closing">
		<h2>Start with your own numbers</h2>
		<p>Send the property address and your last twelve months of operating statements. I read them before we speak.</p>
		<GeoCTA />
	</section>
</Base>

<style>
	/* Full-bleed photographic hero with the headline over a navy gradient so
	   the copy stays legible on any crop. Image sits under the content and
	   scales with the viewport; the band is shorter on phones. */
	.hero {
		position: relative;
		isolation: isolate;
		min-height: 72vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: var(--color-bg);
		overflow: hidden;
	}

	.hero__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 40%;
		z-index: -2;
	}

	.hero__stage {
		position: absolute;
		inset: 0;
		z-index: -2;
	}

	.hero__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 40%;
		opacity: 0;
		transition: opacity 700ms ease;
	}

	.hero__video.is-playing {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__stage {
			display: none;
		}
	}

	.hero__overlay {
		position: absolute;
		inset: 0;
		z-index: -1;
		/* Sharpen pass 2026-09-20: a neutral vignette behind the copy instead of a
		   full-frame navy wash, so the loops keep their colour and edge detail. */
		background:
			radial-gradient(ellipse 70% 80% at 50% 55%, rgba(10, 13, 20, 0.5) 0%, rgba(10, 13, 20, 0.3) 55%, rgba(10, 13, 20, 0) 100%),
			linear-gradient(180deg, rgba(10, 13, 20, 0.28) 0%, rgba(10, 13, 20, 0.08) 40%, rgba(10, 13, 20, 0.34) 100%);
	}

	.hero__content {
		max-width: 760px;
		padding: var(--space-8) var(--space-4) var(--space-7);
	}

	.hero h1 {
		font-size: var(--text-3xl);
		color: var(--color-bg);
		margin-bottom: var(--space-4);
		text-shadow: 0 2px 18px rgba(10, 13, 20, 0.6), 0 1px 3px rgba(10, 13, 20, 0.5);
	}

	/* On the dark hero the shared navy button vanished; a cream button with navy
	   text is the highest-contrast pairing in the palette. */
	.hero :global(.geo-cta) {
		background: var(--color-cream);
		color: var(--color-navy);
		font-weight: 600;
		box-shadow: 0 6px 24px rgba(10, 13, 20, 0.35);
	}

	.hero :global(.geo-cta:hover) {
		background: #ffffff;
		color: var(--color-navy);
	}

	.hero p {
		font-size: var(--text-lg);
		color: #ffffff;
		text-shadow: 0 1px 10px rgba(10, 13, 20, 0.55);
		margin-bottom: var(--space-5);
	}

	@media (max-width: 640px) {
		.hero {
			min-height: 60vh;
		}
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
	}

	.stats {
		background: var(--color-obsidian);
		padding: var(--space-7) var(--space-4);
	}

	.stats__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
		gap: var(--space-4);
		max-width: 1000px;
		margin: 0 auto;
		list-style: none;
		padding: 0;
	}

	.stats__card {
		border: 1px solid rgba(241, 237, 230, 0.22);
		border-radius: 2px;
		padding: var(--space-4);
		text-align: center;
	}

	.stats__value {
		font-family: var(--font-headline);
		font-size: var(--text-3xl);
		color: var(--color-bg);
		margin: 0 0 var(--space-1);
	}

	.stats__label {
		font-size: var(--text-sm);
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: rgba(241, 237, 230, 0.82);
		margin: 0;
	}

	.content-block {
		max-width: 720px;
		margin: 0 auto;
		padding: var(--space-6) var(--space-4);
	}

	.content-block--closing {
		text-align: center;
		background: var(--color-cream);
		border-radius: 4px;
	}

	.content-block--band {
		background: var(--color-cream);
		border-radius: 4px;
	}

	.who {
		display: grid;
		grid-template-columns: 160px 1fr;
		gap: var(--space-4);
		align-items: center;
	}

	.who__portrait {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 4px;
	}

	@media (max-width: 640px) {
		.who {
			grid-template-columns: 1fr;
		}

		.who__portrait {
			max-width: 50%;
		}
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: var(--space-4);
	}

	.service-tile {
		display: block;
		color: inherit;
		text-decoration: none;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		overflow: hidden;
		background: var(--color-bg);
	}

	.service-tile__image {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
	}

	.service-tile h3 {
		font-size: var(--text-lg);
		margin: var(--space-3) var(--space-3) var(--space-1);
		color: var(--color-navy);
	}

	.service-tile p {
		margin: 0 var(--space-3) var(--space-3);
		color: var(--color-slate);
	}

	.service-tile:hover h3 {
		color: var(--color-accent-deep);
	}

	.services-grid > div {
		background: var(--color-cream);
		padding: var(--space-4);
		border-radius: 4px;
	}
</style>

<script>
	import { attachLoopVideos } from '../lib/loop-video'
	attachLoopVideos()
</script>
