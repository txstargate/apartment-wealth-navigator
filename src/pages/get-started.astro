---
import Base from '../layouts/Base.astro'
---

<Base
	title="Get Started | Apartment Wealth Navigator"
	description="Tell us where your building is. Owners in DC, Virginia, and Maryland book directly with Shafiq. Everywhere else routes to a referral."
	canonical="https://apartmentwealthnavigator.com/get-started"
>
	<section class="get-started">
		<h1>Where is the building?</h1>
		<p>
			Your building's location determines the next step: a direct booking with Shafiq, or a
			referral to a trusted partner in your market. The first call is free. Any engagement after it is scoped and quoted in writing before work starts.
		</p>

		<form id="location-form" class="location-form">
			<label for="firstName">First name</label>
			<input id="firstName" name="first_name" type="text" autocomplete="given-name" required />

			<label for="lastName">Last name</label>
			<input id="lastName" name="last_name" type="text" autocomplete="family-name" required />

			<label for="email">Email</label>
			<input id="email" name="email" type="email" required />

			<label for="phone">Mobile number</label>
			<input id="phone" name="phone" type="tel" autocomplete="tel" required />

			<label for="location">City, state, or ZIP</label>
			<input id="location" name="location" type="text" placeholder="e.g. Washington, DC or 20009" required />
			<button type="submit">Continue</button>
			<p class="consent">
				By submitting, you agree to be contacted by phone, text, or email about your inquiry.
				Message and data rates may apply. Reply STOP to opt out.
			</p>
		</form>

		<div id="thank-you" class="result-panel" hidden>
			<h2>Thank you, <span id="thank-you-name"></span>.</h2>
			<p>Your details are in. Here is the next step.</p>
		</div>

		<div id="local-panel" class="result-panel" hidden>
			<h2>Book a time with Shafiq</h2>
			<p>Your building is in the DC, Virginia, or Maryland service area.</p>
			<!-- Booking link is set by src/lib/booking.ts (live GHL widget). -->
			<a id="local-booking-link" class="result-link" href="#" target="_blank" rel="noopener">
				Book your building review
			</a>
		</div>

		<div id="referral-panel" class="result-panel" hidden>
			<h2>Get matched with a local advisor</h2>
			<p>Shafiq covers DC, Virginia, and Maryland. We will route your building to a trusted partner in your market.</p>
			<a id="referral-intake-link" class="result-link" href="#" target="_blank" rel="noopener">
				Start the referral intake
			</a>
		</div>
	</section>
</Base>

<script>
	import { routeByLocation } from '../lib/geo'
	import { buildLeadPayload, submitLead } from '../lib/ghl'
	import { bookingUrl } from '../lib/booking'
	import { referralIntakeUrl } from '../lib/referral'

	const GHL_BOOKING_URL = bookingUrl(import.meta.env.PUBLIC_GHL_BOOKING_URL)
	const REFERRAL_INTAKE_URL = referralIntakeUrl(import.meta.env.PUBLIC_REFERRAL_INTAKE_URL)

	const form = document.getElementById('location-form') as HTMLFormElement
	const firstNameInput = document.getElementById('firstName') as HTMLInputElement
	const lastNameInput = document.getElementById('lastName') as HTMLInputElement
	const thankYou = document.getElementById('thank-you') as HTMLElement
	const thankYouName = document.getElementById('thank-you-name') as HTMLElement
	const emailInput = document.getElementById('email') as HTMLInputElement
	const phoneInput = document.getElementById('phone') as HTMLInputElement
	const locationInput = document.getElementById('location') as HTMLInputElement
	const localPanel = document.getElementById('local-panel') as HTMLElement
	const referralPanel = document.getElementById('referral-panel') as HTMLElement
	const localLink = document.getElementById('local-booking-link') as HTMLAnchorElement
	const referralLink = document.getElementById('referral-intake-link') as HTMLAnchorElement

	form.addEventListener('submit', async (event) => {
		event.preventDefault()
		const route = routeByLocation(locationInput.value)

		const payload = buildLeadPayload({
			firstName: firstNameInput.value,
			lastName: lastNameInput.value,
			email: emailInput.value,
			phone: phoneInput.value,
			location: locationInput.value,
			toolName: 'Get a Read',
			sourcePage: window.location.pathname,
		})
		await submitLead(payload)

		thankYouName.textContent = payload.first_name
		thankYou.hidden = false

		if (route === 'local') {
			localLink.href = GHL_BOOKING_URL
			localPanel.hidden = false
			referralPanel.hidden = true
		} else {
			referralLink.href = REFERRAL_INTAKE_URL
			referralPanel.hidden = false
			localPanel.hidden = true
		}
	})
</script>

<style>
	.get-started {
		max-width: 600px;
		margin: 0 auto;
		padding: var(--space-6) var(--space-4);
	}

	.location-form {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin-top: var(--space-5);
	}

	.location-form label {
		font-weight: 600;
	}

	.location-form input {
		font-size: var(--text-base);
		padding: var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: 2px;
	}

	.location-form button {
		align-self: flex-start;
		background: var(--color-navy);
		color: var(--color-bg);
		border: none;
		font-size: var(--text-base);
		font-weight: 600;
		padding: var(--space-2) var(--space-4);
		border-radius: 2px;
		cursor: pointer;
	}

	.location-form button:hover {
		background: var(--color-accent);
		color: var(--color-obsidian);
	}

	.consent {
		font-size: var(--text-sm);
		color: var(--color-slate);
		margin-top: var(--space-1);
	}

	.result-panel {
		margin-top: var(--space-6);
		padding-top: var(--space-5);
		border-top: 1px solid var(--color-border);
	}

	.result-link {
		display: inline-block;
		margin-top: var(--space-3);
		background: var(--color-navy);
		color: var(--color-bg);
		text-decoration: none;
		font-weight: 600;
		padding: var(--space-2) var(--space-4);
		border-radius: 2px;
	}

	.result-link:hover {
		background: var(--color-accent);
		color: var(--color-obsidian);
	}
</style>
