---
import { getCollection, render } from 'astro:content'
import { getImage } from 'astro:assets'
import Base from '../../layouts/Base.astro'
import JsonLd from '../../components/JsonLd.astro'
import GeoCTA from '../../components/GeoCTA.astro'
import { filterPublished } from '../../lib/content'
import { youtubeThumbnailUrl } from '../../lib/youtube'
import { WATCH_PILOT_SLUGS, watchUrl, watchEmbedUrl, watchTitle, buildWatchVideoSchema } from '../../lib/watch'

// Watch page: the video leads, in a real iframe present in the first HTML
// response (the article pages use a click-to-play facade that Google cannot
// see). Text below is the article's own description and its section headings.
export async function getStaticPaths() {
  const entries = [
    ...filterPublished(await getCollection('universal')),
    ...filterPublished(await getCollection('dc')),
  ]
  return WATCH_PILOT_SLUGS.map((slug) => {
    const entry = entries.find((e) => e.id === slug && e.data.youtubeId)
    if (!entry) throw new Error(`Watch pilot slug "${slug}" is not a published article with a youtubeId`)
    return { params: { slug }, props: { entry } }
  })
}

const { entry } = Astro.props
const { headings } = await render(entry)
const sections = headings.filter((h) => h.depth === 2)
const id = entry.data.youtubeId as string
const pageUrl = watchUrl(entry.id)
const articlePath = `/insights/${entry.id}/`
const publishIso = new Date(entry.data.publishDate).toISOString()
const publishLabel = new Date(entry.data.publishDate).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
})
const cover = entry.data.coverImage
  ? await getImage({ src: entry.data.coverImage, width: 1200, format: 'jpg' })
  : null
const thumbnailUrl = cover
  ? `https://apartmentwealthnavigator.com${cover.src}`
  : youtubeThumbnailUrl(id, 'sddefault')

const videoSchema = buildWatchVideoSchema({
  title: entry.data.title,
  description: entry.data.description,
  uploadDate: publishIso,
  youtubeId: id,
  thumbnailUrl,
  pageUrl,
})
---

<Base
  title={watchTitle(entry.data.seoTitle ?? entry.data.title)}
  description={entry.data.description}
  canonical={watchUrl(entry.id)}
  ogImage={cover?.src}
>
  <JsonLd data={videoSchema} />
  <article class="watch">
    <p class="watch__kicker">Video</p>
    <h1>{entry.data.title}</h1>
    <p class="watch__byline">
      By <a href="/about/">Shafiq Hirani, CCIM</a> · <time datetime={publishIso}>{publishLabel}</time>
    </p>

    <div class="watch__player">
      <iframe
        src={watchEmbedUrl(id)}
        title={entry.data.title}
        width="1280"
        height="720"
        loading="eager"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>

    <div class="watch__body">
      <p>{entry.data.description}</p>

      {
        sections.length > 0 && (
          <>
            <h2>Covered in the full article</h2>
            <ul class="watch__sections">
              {sections.map((h) => (
                <li>
                  <a href={`${articlePath}#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }

      <p class="watch__read">
        <a href={articlePath}>Read the full article</a>
      </p>
    </div>

    <GeoCTA />
  </article>
</Base>

<style>
  .watch {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4);
  }

  .watch__kicker {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    color: var(--color-accent);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .watch__byline {
    font-size: var(--text-sm);
    color: var(--color-slate);
    margin: 0 0 var(--space-4);
  }

  .watch__player {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: var(--space-4) 0 var(--space-5);
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-navy);
  }

  .watch__player iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .watch__body {
    margin-bottom: var(--space-5);
  }

  .watch__sections {
    padding-left: var(--space-4);
  }

  .watch__read {
    font-family: var(--font-headline);
    font-size: var(--text-lg);
  }
</style>
