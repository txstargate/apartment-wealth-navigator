---
import { getCollection, getEntry, render } from 'astro:content'
import Article from '../../layouts/Article.astro'

export async function getStaticPaths() {
  const universal = await getCollection('universal')
  const dc = await getCollection('dc')

  return [
    ...universal.map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    })),
    ...dc.map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    })),
  ]
}

const { entry } = Astro.props
const { Content } = await render(entry)

let counterpart = null
let direction: 'up' | 'down' | null = null

if (entry.data.dcCounterpart) {
  counterpart = await getEntry('dc', entry.data.dcCounterpart)
  direction = 'down'
} else if (entry.data.universalParent) {
  counterpart = await getEntry('universal', entry.data.universalParent)
  direction = 'up'
}
---

<Article entry={entry} counterpart={counterpart} direction={direction}>
  <Content />
</Article>
