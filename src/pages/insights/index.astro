---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../../layouts/Base.astro'
import { filterPublished } from '../../lib/content'

const universal = filterPublished(await getCollection('universal'))
const dc = filterPublished(await getCollection('dc'))
---

<Base
	title="Insights | Apartment Wealth Navigator"
	description="NOI, refinance, and sale-readiness guides for apartment owners, with a DC, Virginia, and Maryland branch for local search."
	canonical="https://apartmentwealthnavigator.com/insights/"
>
	<section class="insights">
		<h1>Insights</h1>

		<h2>Universal library</h2>
		<ul class="insights__list">
			{
				universal.map((entry) => (
					<li>
						<a class="insights__item" href={`/insights/${entry.id}`}>
							{entry.data.coverImage && (
								<Image
									class="insights__thumb"
									src={entry.data.coverImage}
									alt=""
									widths={[320, 640]}
									sizes="(max-width: 640px) 100vw, 200px"
									loading="lazy"
								/>
							)}
							<span class="insights__text">
								<span class="insights__title">{entry.data.title}</span>
								<span class="insights__description">{entry.data.description}</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>

		<h2>DC, Virginia, and Maryland library</h2>
		<ul class="insights__list">
			{
				dc.map((entry) => (
					<li>
						<a class="insights__item" href={`/insights/${entry.id}`}>
							{entry.data.coverImage && (
								<Image
									class="insights__thumb"
									src={entry.data.coverImage}
									alt=""
									widths={[320, 640]}
									sizes="(max-width: 640px) 100vw, 200px"
									loading="lazy"
								/>
							)}
							<span class="insights__text">
								<span class="insights__title">{entry.data.title}</span>
								<span class="insights__description">{entry.data.description}</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Base>

<style>
	.insights {
		max-width: 720px;
		margin: 0 auto;
		padding: var(--space-6) var(--space-4);
	}

	.insights__list {
		list-style: none;
		margin: 0 0 var(--space-5);
		padding: 0;
	}

	.insights__list li {
		border-top: 1px solid var(--color-border);
		padding: var(--space-3) 0;
	}

	.insights__item {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: var(--space-4);
		align-items: start;
		color: var(--color-text);
		text-decoration: none;
	}

	.insights__thumb {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		border-radius: 4px;
	}

	.insights__text {
		display: block;
	}

	.insights__title {
		display: block;
		font-family: var(--font-headline);
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--color-navy);
		margin-bottom: var(--space-1);
	}

	.insights__description {
		display: block;
		color: var(--color-slate);
		font-size: var(--text-sm);
	}

	.insights__item:hover .insights__title {
		color: var(--color-accent-deep);
	}

	@media (max-width: 640px) {
		.insights__item {
			grid-template-columns: 1fr;
		}
	}
</style>
