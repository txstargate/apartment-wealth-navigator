---
const navItems = [
	{ label: 'Home', href: '/' },
	{ label: 'About', href: '/about' },
	{ label: 'Services', href: '/services' },
	{ label: 'Insights', href: '/insights' },
	{ label: 'Tools', href: '/tools' },
	{ label: 'DMV', href: '/locations' },
	{ label: 'Contact', href: '/contact' },
]

// Landing pages (lead-magnet funnels moved from GoHighLevel) pass minimal:
// brand and phone only, no menu, so the page has one exit: the form.
interface Props {
	minimal?: boolean
}
const { minimal = false } = Astro.props
const phoneNumber = '202-290-1055'
const phoneHref = 'tel:+12022901055'
---

<header class="site-header">
	<nav class="site-nav">
		<a class="site-nav__brand" href="/">
			<svg
				class="site-nav__mark"
				xmlns="http://www.w3.org/2000/svg"
				width="32"
				height="32"
				viewBox="0 0 64 64"
				fill="none"
				role="img"
				aria-label="Apartment Wealth Navigator compass mark"
			>
				<path d="M56 23 A26 26 0 0 1 23 56" stroke="#12314F" stroke-width="4.5" stroke-linecap="round"></path>
				<path d="M8 41 A26 26 0 0 1 41 8" stroke="#12314F" stroke-width="4.5" stroke-linecap="round"></path>
				<polygon points="44,18 30,32 33,35" fill="#C5A880"></polygon>
				<polygon points="44,18 33,35 35,31" fill="#A98C63"></polygon>
				<polygon points="20,46 34,32 31,29" fill="#12314F"></polygon>
				<polygon points="20,46 31,29 29,33" fill="#34567C"></polygon>
				<circle cx="32" cy="32" r="3" fill="#12314F"></circle>
			</svg>
			<span class="site-nav__wordmark">Apartment Wealth Navigator</span>
		</a>
		{minimal && <a class="site-nav__phone site-nav__phone--solo" href={phoneHref}>{phoneNumber}</a>}
		{!minimal && (
		<>
		<button
			class="site-nav__toggle"
			type="button"
			aria-expanded="false"
			aria-controls="site-nav-menu"
			aria-label="Open menu"
		>
			<span class="site-nav__toggle-bar"></span>
			<span class="site-nav__toggle-bar"></span>
			<span class="site-nav__toggle-bar"></span>
		</button>
		<div class="site-nav__menu" id="site-nav-menu">
			<ul class="site-nav__links">
				{
					navItems.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
			</ul>
			<a class="site-nav__phone" href={phoneHref}>{phoneNumber}</a>
		</div>
		</>
		)}
	</nav>
</header>

<script>
	// Mobile menu toggle (responsive pass 2026-09-14). Desktop shows the links
	// inline; under 900px they collapse behind the button.
	const toggle = document.querySelector('.site-nav__toggle') as HTMLButtonElement | null
	const menu = document.getElementById('site-nav-menu')
	if (toggle && menu) {
		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') === 'true'
			toggle.setAttribute('aria-expanded', String(!open))
			toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu')
			menu.classList.toggle('is-open', !open)
		})
	}
</script>

<style>
	.site-nav__phone--solo {
		margin-left: auto;
		font-weight: 600;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		max-width: 1200px;
		margin: 0 auto;
		padding: var(--space-3) var(--space-4);
	}

	.site-nav__brand {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-headline);
		font-weight: 600;
		color: var(--color-obsidian);
		text-decoration: none;
		white-space: nowrap;
	}

	.site-nav__mark {
		display: block;
		flex-shrink: 0;
	}

	.site-nav__wordmark {
		line-height: 1;
	}

	.site-nav__toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 44px;
		height: 44px;
		padding: 10px;
		background: transparent;
		border: 1px solid var(--color-border);
		border-radius: 2px;
		cursor: pointer;
	}

	.site-nav__toggle-bar {
		display: block;
		height: 2px;
		background: var(--color-navy);
	}

	.site-nav__menu {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		min-width: 0;
	}

	.site-nav__links {
		display: flex;
		gap: var(--space-4);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-nav__links a {
		color: var(--color-navy);
		text-decoration: none;
		font-size: var(--text-sm);
	}

	.site-nav__links a:hover {
		color: var(--color-accent);
	}

	.site-nav__phone {
		color: var(--color-obsidian);
		text-decoration: none;
		font-size: var(--text-sm);
		white-space: nowrap;
	}

	/* Phones and small tablets: brand + menu button on one row, links in a
	   panel below. The row never exceeds the viewport width. */
	@media (max-width: 900px) {
		.site-nav {
			flex-wrap: wrap;
			gap: var(--space-2) var(--space-3);
			padding: var(--space-2) var(--space-3);
		}

		.site-nav__brand {
			flex: 1 1 auto;
			min-width: 0;
			white-space: normal;
			font-size: 0.95rem;
			line-height: 1.15;
		}

		.site-nav__mark {
			width: 28px;
			height: 28px;
		}

		.site-nav__toggle {
			display: flex;
		}

		.site-nav__menu {
			display: none;
			flex: 1 0 100%;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: var(--space-2) 0 var(--space-3);
			border-top: 1px solid var(--color-border);
		}

		.site-nav__menu.is-open {
			display: flex;
		}

		.site-nav__links {
			flex-direction: column;
			gap: 0;
		}

		.site-nav__links a,
		.site-nav__phone {
			display: block;
			padding: var(--space-2) var(--space-1);
			font-size: var(--text-base);
		}

		.site-nav__phone {
			margin-top: var(--space-1);
			border-top: 1px solid var(--color-border);
			padding-top: var(--space-3);
			font-weight: 600;
		}

		/* Landing pages: the lone phone link stays on the brand row. */
		.site-nav__phone--solo {
			display: inline;
			flex: 0 0 auto;
			margin: 0 0 0 auto;
			border: 0;
			padding: 0;
			font-size: var(--text-sm);
		}
	}
</style>
