---
const navItems = [
	{ label: 'Home', href: '/' },
	{ label: 'About', href: '/about' },
	{ label: 'Services', href: '/services' },
	{ label: 'Insights', href: '/insights' },
	{ label: 'Tools', href: '/tools' },
	{ label: 'Contact', href: '/contact' },
]

// TODO-Shafiq: confirm the phone number to publish here.
const phoneNumber = '(000) 000-0000'
const phoneHref = 'tel:+10000000000'
---

<header class="site-header">
	<nav class="site-nav">
		<a class="site-nav__brand" href="/">
			<svg
				class="site-nav__mark"
				xmlns="http://www.w3.org/2000/svg"
				width="32"
				height="32"
				viewBox="0 0 64 64"
				fill="none"
				role="img"
				aria-label="Apartment Wealth Navigator compass mark"
			>
				<path d="M54 22 A26 26 0 0 1 22 54" stroke="#0F172A" stroke-width="4.5" stroke-linecap="round"></path>
				<path d="M42 10 A26 26 0 0 1 10 42" stroke="#0F172A" stroke-width="4.5" stroke-linecap="round"></path>
				<polygon points="52,12 26,20 36,30" fill="#C5A880"></polygon>
				<polygon points="52,12 36,30 32,44" fill="#A98C63"></polygon>
			</svg>
			<span class="site-nav__wordmark">Apartment Wealth Navigator</span>
		</a>
		<ul class="site-nav__links">
			{
				navItems.map((item) => (
					<li>
						<a href={item.href}>{item.label}</a>
					</li>
				))
			}
		</ul>
		<a class="site-nav__phone" href={phoneHref}>{phoneNumber}</a>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		max-width: 1200px;
		margin: 0 auto;
		padding: var(--space-3) var(--space-4);
	}

	.site-nav__brand {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-headline);
		font-weight: 600;
		color: var(--color-obsidian);
		text-decoration: none;
		white-space: nowrap;
	}

	.site-nav__mark {
		display: block;
		flex-shrink: 0;
	}

	.site-nav__wordmark {
		line-height: 1;
	}

	.site-nav__links {
		display: flex;
		gap: var(--space-4);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-nav__links a {
		color: var(--color-text);
		text-decoration: none;
		font-size: var(--text-sm);
	}

	.site-nav__links a:hover {
		color: var(--color-accent);
	}

	.site-nav__phone {
		color: var(--color-obsidian);
		text-decoration: none;
		font-size: var(--text-sm);
		white-space: nowrap;
	}
</style>
