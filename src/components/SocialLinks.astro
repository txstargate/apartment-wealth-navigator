---

{
	profiles.length > 0 && (
		<ul class="social-links" aria-label="Shafiq Hirani on social media">
			{profiles.map((p) => (
				<li>
					<a href={p.url} target="_blank" rel="me noopener" aria-label={`Shafiq Hirani on ${p.label}`} title={p.label}>
						<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
							<path d={paths[p.id]} fill="currentColor" />
						</svg>
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.social-links {
		list-style: none;
		display: flex;
		justify-content: center;
		gap: var(--space-3);
		margin: 0 0 var(--space-3);
		padding: 0;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		border: 1px solid var(--color-border);
		color: var(--color-navy);
		transition: color 150ms ease, border-color 150ms ease;
	}

	.social-links a:hover,
	.social-links a:focus-visible {
		color: var(--color-accent-deep);
		border-color: var(--color-accent);
	}
</style>
