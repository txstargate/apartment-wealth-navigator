---
import SocialLinks from './SocialLinks.astro'
const year = new Date().getFullYear()
---

<footer class="site-footer">
	<!-- Motto: Insula · Reditus · Exitus, each Latin word glossed directly beneath it. -->
	<p class="site-footer__motto" aria-label="Insula, Reditus, Exitus: the Building, the Return, the Exit">
		<span class="site-footer__motto-item"><span class="site-footer__latin">Insula</span><span class="site-footer__gloss">The Building</span></span>
		<span class="site-footer__motto-sep" aria-hidden="true">·</span>
		<span class="site-footer__motto-item"><span class="site-footer__latin">Reditus</span><span class="site-footer__gloss">The Return</span></span>
		<span class="site-footer__motto-sep" aria-hidden="true">·</span>
		<span class="site-footer__motto-item"><span class="site-footer__latin">Exitus</span><span class="site-footer__gloss">The Exit</span></span>
	</p>
	<p class="site-footer__brokerage">
		RE/MAX Distinctive Commercial · Office <a href="tel:+12028003200">202-800-3200</a>
	</p>
	<p class="site-footer__brokerage">
		<a href="mailto:shirani@enterprisere.com">shirani@enterprisere.com</a>
	</p>
	<SocialLinks />
	<nav class="site-footer__resources" aria-label="Free resources">
		<span class="site-footer__resources-label">Free resources</span>
		<a href="/noi-navigator/">NOI Navigator™</a>
		<a href="/refinance-readiness/">Refinance Navigator™</a>
		<a href="/sale-readiness/">Exit Navigator™</a>
		<a href="/value-navigator/">Value Navigator™</a>
		<a href="/tools/noi-check/">NOI Quick Check</a>
	</nav>
	<nav class="site-footer__legal">
		<a href="/privacy">Privacy Policy</a>
		<a href="/terms">Terms of Use</a>
		<a href="/disclosures">Disclosures</a>
	</nav>
	<p>&copy; {year} Apartment Wealth Navigator. All rights reserved.</p>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		padding: var(--space-4);
		text-align: center;
		color: var(--color-slate);
		font-size: var(--text-sm);
	}

	/* Three centered columns: Latin word on top, its gloss centered beneath,
	   separators aligned with the Latin line. Wraps on narrow screens. */
	.site-footer__motto {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: flex-start;
		column-gap: var(--space-2);
		row-gap: var(--space-2);
		font-family: var(--font-body);
		margin: 0 0 var(--space-4);
	}

	.site-footer__motto-item {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.site-footer__latin,
	.site-footer__motto-sep {
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 3px;
		font-size: var(--text-sm);
		line-height: 1.4;
	}

	/* letter-spacing adds trailing space after the last letter; offset it so
	   the word itself sits centered over the gloss. */
	.site-footer__latin {
		margin-right: -3px;
	}

	.site-footer__gloss {
		font-size: var(--text-xs, 0.75rem);
		color: var(--color-slate);
		letter-spacing: 0;
		line-height: 1.3;
		margin-top: var(--space-1);
		white-space: nowrap;
	}

	.site-footer__brokerage {
		margin: 0 0 var(--space-2);
	}

	.site-footer__brokerage a {
		color: var(--color-slate);
	}

	.site-footer__resources {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-2) var(--space-4);
		margin: 0 0 var(--space-3);
	}

	.site-footer__resources-label {
		color: var(--color-accent-deep);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: var(--text-xs, 0.75rem);
		align-self: center;
	}

	.site-footer__resources a {
		color: var(--color-navy);
		text-decoration: none;
	}

	.site-footer__resources a:hover {
		color: var(--color-accent-deep);
	}

	.site-footer__legal {
		display: flex;
		justify-content: center;
		gap: var(--space-4);
		margin: 0 0 var(--space-2);
	}

	.site-footer__legal a {
		color: var(--color-slate);
		text-decoration: none;
	}

	.site-footer__legal a:hover {
		color: var(--color-accent);
	}
</style>
