---
const year = new Date().getFullYear()
---

<footer class="site-footer">
	<p class="site-footer__motto">Insula · Reditus · Exitus</p>
	<p class="site-footer__brokerage">
		RE/MAX Distinctive Commercial · Office <a href="tel:+12028003200">202-800-3200</a>
	</p>
	<nav class="site-footer__legal">
		<a href="/privacy">Privacy Policy</a>
		<a href="/terms">Terms of Use</a>
		<a href="/disclosures">Disclosures</a>
	</nav>
	<p>&copy; {year} Apartment Wealth Navigator. All rights reserved.</p>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		padding: var(--space-4);
		text-align: center;
		color: var(--color-slate);
		font-size: var(--text-sm);
	}

	.site-footer__motto {
		font-family: var(--font-body);
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 3px;
		font-size: var(--text-sm);
		margin: 0 0 var(--space-2);
	}

	.site-footer__brokerage {
		margin: 0 0 var(--space-2);
	}

	.site-footer__brokerage a {
		color: var(--color-slate);
	}

	.site-footer__legal {
		display: flex;
		justify-content: center;
		gap: var(--space-4);
		margin: 0 0 var(--space-2);
	}

	.site-footer__legal a {
		color: var(--color-slate);
		text-decoration: none;
	}

	.site-footer__legal a:hover {
		color: var(--color-accent);
	}
</style>
