---
// Click-to-play YouTube facade. The page ships one image and a button; the
// real player is injected only when the visitor clicks, so the click both
// loads the iframe and starts playback (that is what makes the view count),
// and no YouTube script runs until then. No YouTube chrome is hidden or
// covered: the title bar and "Watch on YouTube" stay visible once playing,
// per YouTube's terms.
import { youtubeEmbedUrl, youtubeThumbnailUrl, youtubeWatchUrl } from '../lib/youtube'

interface Props {
  id: string
  title: string
  /** Optional local poster; defaults to YouTube's own thumbnail. */
  poster?: string
}

const { id, title, poster } = Astro.props
const embed = youtubeEmbedUrl(id, { autoplay: true })
const watch = youtubeWatchUrl(id)
const thumb = poster ?? youtubeThumbnailUrl(id)
---

<div class="yt-facade" data-embed={embed} data-title={title}>
	<a class="yt-facade__link" href={watch} target="_blank" rel="noopener">
		<img class="yt-facade__poster" src={thumb} alt="" loading="lazy" decoding="async" width="1280" height="720" />
		<span class="yt-facade__play" aria-hidden="true">
			<svg viewBox="0 0 68 48" width="68" height="48" focusable="false">
				<path d="M66.5 7.7c-.8-2.9-3-5.1-5.9-5.9C55.4.4 34 .4 34 .4s-21.4 0-26.6 1.4C4.5 2.6 2.3 4.8 1.5 7.7.1 12.9.1 24 .1 24s0 11.1 1.4 16.3c.8 2.9 3 5.1 5.9 5.9 5.2 1.4 26.6 1.4 26.6 1.4s21.4 0 26.6-1.4c2.9-.8 5.1-3 5.9-5.9C67.9 35.1 67.9 24 67.9 24s0-11.1-1.4-16.3z" fill="#12314F"></path>
				<path d="M27 34.6l17.6-10.6L27 13.4v21.2z" fill="#F1EDE6"></path>
			</svg>
		</span>
		<span class="yt-facade__label">Play: {title}</span>
	</a>
</div>

<script>
	import { YOUTUBE_IFRAME_ALLOW } from '../lib/youtube'

	// Progressive enhancement: without JS the poster is a plain link to
	// YouTube. With JS, the click swaps in the player in place.
	for (const facade of document.querySelectorAll<HTMLElement>('.yt-facade')) {
		const link = facade.querySelector<HTMLAnchorElement>('.yt-facade__link')
		if (!link) continue
		link.addEventListener('click', (event) => {
			event.preventDefault()
			const iframe = document.createElement('iframe')
			iframe.src = facade.dataset.embed ?? ''
			iframe.title = facade.dataset.title ?? 'Video'
			iframe.allow = YOUTUBE_IFRAME_ALLOW
			iframe.setAttribute('allowfullscreen', '')
			iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin')
			iframe.className = 'yt-facade__player'
			facade.replaceChildren(iframe)
			facade.classList.add('is-playing')
		})
	}
</script>

<style>
	.yt-facade {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: var(--color-obsidian);
		border-radius: 4px;
		overflow: hidden;
	}

	.yt-facade__link {
		position: absolute;
		inset: 0;
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.yt-facade__poster {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.yt-facade__play {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		filter: drop-shadow(0 2px 8px rgba(10, 13, 20, 0.45));
		transition: transform 150ms ease;
	}

	.yt-facade__link:hover .yt-facade__play,
	.yt-facade__link:focus-visible .yt-facade__play {
		transform: translate(-50%, -50%) scale(1.08);
	}

	.yt-facade__label {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
	}

	.yt-facade :global(.yt-facade__player) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
