---
// GA4 + Meta Pixel, consent-gated. Renders nothing until both an ID is
// set and the visitor has granted consent via the banner below.
//
// Owner Shafiq: set PUBLIC_GA4_ID to the real GA4 measurement ID (format G-XXXXXXXXXX) when a campaign needs it.
const GA4_ID = import.meta.env.PUBLIC_GA4_ID
// Owner Shafiq: set PUBLIC_META_PIXEL_ID to the real Meta Pixel ID when a campaign needs it.
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID

const hasGa4 = Boolean(GA4_ID)
const hasMetaPixel = Boolean(META_PIXEL_ID)
const hasAnyAnalytics = hasGa4 || hasMetaPixel
---

{
	hasAnyAnalytics && (
		<div
			id="consent-banner"
			class="consent-banner"
			data-ga4-id={GA4_ID}
			data-meta-pixel-id={META_PIXEL_ID}
			hidden
		>
			<p>This site uses analytics cookies to understand traffic. Allow analytics?</p>
			<div class="consent-banner__actions">
				<button id="consent-accept" type="button">Accept</button>
				<button id="consent-decline" type="button">Decline</button>
			</div>
		</div>
	)
}

{
	hasAnyAnalytics && (
		<script>
			import { CONSENT_KEY, parseConsent, shouldLoadAnalytics, shouldShowConsentBanner } from '../lib/consent'

			function loadGa4(id: string) {
				const loader = document.createElement('script')
				loader.async = true
				loader.src = `https://www.googletagmanager.com/gtag/js?id=${id}`
				document.head.appendChild(loader)

				const inline = document.createElement('script')
				inline.textContent = `window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config', '${id}');`
				document.head.appendChild(inline)
			}

			function loadMetaPixel(id: string) {
				const inline = document.createElement('script')
				inline.textContent = `!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${id}');fbq('track','PageView');`
				document.head.appendChild(inline)

				const noscript = document.createElement('noscript')
				const img = document.createElement('img')
				img.height = 1
				img.width = 1
				img.style.display = 'none'
				img.src = `https://www.facebook.com/tr?id=${id}&ev=PageView&noscript=1`
				noscript.appendChild(img)
				document.body.appendChild(noscript)
			}

			const banner = document.getElementById('consent-banner') as HTMLElement
			const acceptBtn = document.getElementById('consent-accept') as HTMLButtonElement
			const declineBtn = document.getElementById('consent-decline') as HTMLButtonElement
			const ga4Id = banner.dataset.ga4Id
			const metaPixelId = banner.dataset.metaPixelId

			function applyConsent() {
				const consent = parseConsent(localStorage.getItem(CONSENT_KEY))
				if (shouldLoadAnalytics(consent)) {
					if (ga4Id) loadGa4(ga4Id)
					if (metaPixelId) loadMetaPixel(metaPixelId)
				}
				banner.hidden = !shouldShowConsentBanner(consent)
			}

			acceptBtn.addEventListener('click', () => {
				localStorage.setItem(CONSENT_KEY, 'granted')
				applyConsent()
			})

			declineBtn.addEventListener('click', () => {
				localStorage.setItem(CONSENT_KEY, 'denied')
				banner.hidden = true
			})

			applyConsent()
		</script>
	)
}

<style>
	.consent-banner {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 100;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		background: var(--color-obsidian);
		color: var(--color-bg);
		padding: var(--space-3) var(--space-4);
		font-size: var(--text-sm);
	}

	.consent-banner p {
		margin: 0;
	}

	.consent-banner__actions {
		display: flex;
		gap: var(--space-2);
	}

	.consent-banner__actions button {
		border: 1px solid var(--color-bg);
		background: transparent;
		color: var(--color-bg);
		padding: var(--space-1) var(--space-3);
		border-radius: 2px;
		cursor: pointer;
		font-size: var(--text-sm);
	}

	#consent-accept {
		background: var(--color-bg);
		color: var(--color-obsidian);
	}
</style>
