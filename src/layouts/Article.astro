---
import Base from './Base.astro'
import JsonLd from '../components/JsonLd.astro'
import GeoCTA from '../components/GeoCTA.astro'
import { buildArticleSchema, buildVideoSchema } from '../lib/schema'

interface Props {
  entry: any
  counterpart?: any
  direction?: 'up' | 'down' | null
}

const { entry, counterpart, direction = null } = Astro.props
const canonical = `https://apartmentwealthnavigator.com/insights/${entry.id}`
const publishDateIso = new Date(entry.data.publishDate).toISOString()

const articleSchema = buildArticleSchema({
  title: entry.data.title,
  description: entry.data.description,
  url: canonical,
  author: 'Shafiq Hirani',
  datePublished: publishDateIso,
})

const videoSchema = entry.data.youtubeId
  ? buildVideoSchema({
      title: entry.data.title,
      description: entry.data.description,
      uploadDate: publishDateIso,
      embedUrl: `https://www.youtube.com/embed/${entry.data.youtubeId}`,
    })
  : null
---

<Base title={entry.data.title} description={entry.data.description} canonical={canonical}>
  <JsonLd data={articleSchema} />
  {videoSchema && <JsonLd data={videoSchema} />}
  <article class="article">
    <p class="article__pillar">{entry.data.pillar.toUpperCase()}</p>
    <h1>{entry.data.title}</h1>

    {
      entry.data.youtubeId && (
        <div class="article__video">
          <iframe
            src={`https://www.youtube.com/embed/${entry.data.youtubeId}`}
            title={entry.data.title}
            loading="lazy"
            allowfullscreen
          />
        </div>
      )
    }

    <div class="article__body">
      <slot />
    </div>

    {
      counterpart && direction === 'down' && (
        <p class="article__crosslink">
          Own a building in DC, Virginia, or Maryland?{' '}
          <a href={`/insights/${counterpart.id}`}>Read what this looks like in your market.</a>
        </p>
      )
    }

    {
      counterpart && direction === 'up' && (
        <p class="article__crosslink">
          Read the universal guide this article builds on:{' '}
          <a href={`/insights/${counterpart.id}`}>{counterpart.data.title}</a>
        </p>
      )
    }

    <GeoCTA />
  </article>
</Base>

<style>
  .article {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4);
  }

  .article__pillar {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    color: var(--color-accent);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .article__video {
    position: relative;
    padding-top: 56.25%;
    margin: var(--space-4) 0;
  }

  .article__video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .article__body {
    margin-bottom: var(--space-5);
  }

  .article__crosslink {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
    margin-bottom: var(--space-4);
  }
</style>
